# Set this only when deploying under a non-root base path.
# For GitHub Pages project sites: /today-eat-what/
PUBLIC_BASE_PATH=/

# WeChat Mini Program. AppID is injected into the generated DevTools config.
TARO_APP_ID=
# Use an absolute path outside the repository. Required for preview/upload.
WEAPP_PRIVATE_KEY_PATH=
# Optional note for the WeChat version list.
WEAPP_DESC=
